# LLM 配置（OpenAI 兼容接口）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# 未配置 API Key 时使用 mock 模式（返回示例数据）
LLM_MOCK_MODE=true

# Runtime V2 全局熔断开关。保持 false 时所有项目继续走原 BackgroundTasks 链路。
AGENT_RUNTIME_V2_ENABLED=false
# AI 小助手统一 Runtime 灰度开关；默认关闭，避免改变现有 SSE 链路。
UNIFIED_AGENT_RUNTIME_ENABLED=false
# observe 仅记账与预警；enforce 才执行硬预算。
RUNTIME_BUDGET_MODE=observe
# SQLite Agent Worker 空闲轮询间隔（秒）。
AGENT_WORKER_POLL_SECONDS=1.0

# 评测专用 LLM（AI Judge / 召回率判定），留空则复用上面的生成模型配置
EVAL_LLM_API_KEY=
EVAL_LLM_BASE_URL=
EVAL_LLM_MODEL=

# Embedding 模型（知识库检索），不配置则知识库功能不可用
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# Rerank 模型（知识库检索精排，可选），留空则只做混合检索融合排序
# 推荐：硅基流动 https://api.siliconflow.cn/v1 + BAAI/bge-reranker-v2-m3
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=

# 额外允许的自建模型 API 域名，逗号分隔；内置预设服务商无需配置
MODEL_API_EXTRA_HOSTS=

# 登录账号（默认 admin / nini123456）
AUTH_USERNAME=demo_admin
AUTH_PASSWORD=change-me-before-public-deploy
AUTH_TOKEN_TTL_HOURS=24
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
ALLOW_REGISTRATION=true
REGISTRATION_MAX_PER_HOUR=5

# 数据库（默认 SQLite，生产可改为 PostgreSQL）
DATABASE_URL=sqlite:///./data/app.db

# LangGraph 工作流检查点（可选，默认 backend/data/langgraph_checkpoints.sqlite）
WB_LANGGRAPH_CHECKPOINT_PATH=
# 测试助手人机确认检查点（可选，默认 backend/data/agent_checkpoints.sqlite）
WB_AGENT_CHECKPOINT_PATH=

# 后端
BACKEND_PORT=8000
DEBUG=true

# 前端跨域
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
